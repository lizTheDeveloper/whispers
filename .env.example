# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Base URL of the shared LLM proxy. Without this, the server silently falls
# back to http://localhost:4242 and every LLM call fails with ECONNREFUSED.
LLM_PROXY_URL=

# Port the Express + WebSocket server listens on. vite.config.ts derives its
# dev proxy target from this same value, so keep this in sync with wherever
# the server is actually running.
PORT=3001

# Optional. Used by src/server/image-gen.ts for DeepInfra image generation.
DEEPINFRA_API_KEY=

# Optional overrides — safe to leave unset, defaults shown in comments.
# DATA_DIR=./data
# STATE_DIR defaults to DATA_DIR. Set it separately when DATA_DIR is
# read-only/image-baked static content (scenarios/, dm-presets/, systems/)
# and the live database needs its own writable, volume-mounted location —
# see docker-compose.prod.yml and DEPLOY.md.
# STATE_DIR=./data
# ROOM_TEARDOWN_GRACE_MS=30000
