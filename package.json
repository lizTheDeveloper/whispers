{
  "name": "@multiverse-studios/whispers",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm:dev:server\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "test": "vitest",
    "test:run": "vitest run",
    "start": "node dist/server/server/index.js"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.0",
    "@sentry/browser": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "better-sqlite3": "^11.7.0",
    "express": "^5.1.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "mathjs": "^15.2.0"
  }
}
